# Convex deployment URL (required for admin CMS)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Convex HTTP actions URL (optional — derived from CONVEX_URL if omitted)
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
# Production site URL — used for canonical URLs, sitemap, and Open Graph (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://m5painting.com
