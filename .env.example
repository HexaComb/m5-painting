# Convex deployment URL (required for admin CMS)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Convex HTTP actions URL (optional — derived from CONVEX_URL if omitted)
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
# Production site URL — used for canonical URLs, sitemap, and Open Graph (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://m5painting.com

# Analytics (optional — set in Vercel / .env.local for production)
# Vercel Web Analytics: enable in Vercel dashboard → Analytics (uses @vercel/analytics, no env var; gated by cookie banner)
# Use GTM OR direct GA4, not both (avoids double-counting if GA4 is already in GTM)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=123456789012345

# SerpApi (set in Convex dashboard as SERP_API_KEY — not NEXT_PUBLIC_*)
# SERP_API_KEY=your_serpapi_key

# RapidAPI instagram120 (set in Convex dashboard as RAPIDAPI_KEY — not NEXT_PUBLIC_*)
# RAPIDAPI_KEY=your_rapidapi_key
